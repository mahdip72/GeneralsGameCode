+	template <typename T>
+	static DWORD StoreOpaqueHandle(std::unordered_map<DWORD, T *> &handles,
+		T *object, DWORD &nextHandle, DWORD firstHandle, DWORD lastHandle)
+	{
+		if (object == nullptr || nextHandle == 0 || nextHandle < firstHandle ||
+			nextHandle > lastHandle)
