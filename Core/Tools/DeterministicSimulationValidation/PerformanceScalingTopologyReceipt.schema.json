{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "PerformanceScalingTopologyReceipt.schema.json",
  "title": "Installed Stage 5 physical topology receipt",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "producer", "source", "sourceCommit", "executableSha256", "processId", "commandLine", "logicalProcessors", "selectedLanes"],
  "properties": {
    "schemaVersion": { "const": 1 },
    "producer": { "const": "installed-runtime-scaling-runner-v1" },
    "source": { "const": "GetSystemCpuSetInformation" },
    "sourceCommit": { "type": "string", "pattern": "^[0-9a-f]{40}$" },
    "executableSha256": { "$ref": "#/$defs/sha256" },
    "processId": { "type": "integer", "minimum": 1 },
    "commandLine": { "type": "string", "minLength": 1 },
    "logicalProcessors": { "type": "array", "minItems": 16, "items": { "$ref": "#/$defs/logicalProcessor" } },
    "selectedLanes": { "type": "array", "minItems": 3, "maxItems": 3, "items": { "$ref": "#/$defs/lane" } }
  },
  "$defs": {
    "sha256": { "type": "string", "pattern": "^[0-9A-F]{64}$" },
    "logicalProcessor": {
      "type": "object", "additionalProperties": false,
      "required": ["logicalProcessorIndex", "physicalCoreIndex"],
      "properties": {
        "logicalProcessorIndex": { "type": "integer", "minimum": 0 },
        "physicalCoreIndex": { "type": "integer", "minimum": 0, "maximum": 63 }
      }
    },
    "lane": {
      "type": "object", "additionalProperties": false,
      "required": ["name", "requestedWorkers", "selectedLogicalProcessorIndices"],
      "properties": {
        "name": { "enum": ["forced-one", "physical-8", "physical-16"] },
        "requestedWorkers": { "enum": [1, 8, 16] },
        "selectedLogicalProcessorIndices": {
          "type": "array", "minItems": 1, "maxItems": 16,
          "items": { "type": "integer", "minimum": 0 }, "uniqueItems": true
        }
      }
    }
  }
}
