{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://generalsgamecode.invalid/schemas/stage5-final-evidence.json",
  "title": "GeneralsGameCode Stage 5 final acceptance evidence envelope",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion", "evidenceKind", "status", "sourceCommit", "title",
    "architecture", "artifactSetSha256", "recordedUtc", "cohortNonce",
    "runtimeClosure", "attachments", "details"
  ],
  "properties": {
    "schemaVersion": { "type": "integer", "const": 1 },
    "evidenceKind": {
      "type": "string",
      "enum": [
        "deterministic-runtime", "replay-determinism", "fresh-ai",
        "performance-scaling", "mixed-worker-multiplayer",
        "combined-stage4-stage5-installed-runtime", "premium-review", "manual-acceptance"
      ]
    },
    "status": { "type": "string", "const": "passed" },
    "sourceCommit": { "type": "string", "pattern": "^[0-9a-f]{40}$" },
    "title": { "type": "string", "enum": ["Generals", "ZeroHour", "Both"] },
    "architecture": { "type": "string", "const": "x64" },
    "artifactSetSha256": { "type": "string", "pattern": "^[0-9A-F]{64}$" },
    "recordedUtc": { "type": "string", "format": "date-time" },
    "cohortNonce": { "type": "string", "format": "uuid" },
    "runtimeClosure": {
      "type": "object",
      "additionalProperties": false,
      "required": ["dependencyManifestSha256", "closureSha256"],
      "properties": {
        "dependencyManifestSha256": { "type": "string", "pattern": "^[0-9A-F]{64}$" },
        "closureSha256": { "type": "string", "pattern": "^[0-9A-F]{64}$" }
      }
    },
    "attachments": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["role", "title", "path", "sha256", "trustDomain"],
        "properties": {
          "role": { "type": "string", "minLength": 1 },
          "title": { "type": "string", "enum": ["Generals", "ZeroHour", "Both"] },
          "path": { "$ref": "#/$defs/relativePath" },
          "sha256": { "type": "string", "pattern": "^[0-9A-F]{64}$" },
          "trustDomain": {
            "type": "string",
            "enum": [
              "executable", "host-runner", "reviewed-fixture", "premium-review",
              "manual-approval", "installed-runtime"
            ]
          }
        }
      }
    },
    "details": { "type": "object" }
  },
  "$defs": {
    "relativePath": {
      "type": "string",
      "minLength": 1,
      "not": { "pattern": "^(?:[A-Za-z]:|[\\/])" },
      "pattern": "^(?!.*(?:^|[\\/])\\.\\.(?:[\\/]|$)).+$"
    }
  }
}
