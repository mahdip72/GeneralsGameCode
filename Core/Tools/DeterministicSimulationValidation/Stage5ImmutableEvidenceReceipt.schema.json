{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://generalsgamecode.invalid/schemas/stage5-immutable-evidence-receipt.json",
  "title": "GeneralsGameCode Stage 5 trust-domain evidence receipt",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion", "evidenceKind", "status", "role", "trustDomain",
    "producer", "producerVersion", "sourceCommit", "title", "architecture",
    "artifactSetSha256", "recordedUtc", "cohortNonce", "runtimeClosure",
    "details", "provenance"
  ],
  "properties": {
    "schemaVersion": { "const": 1 },
    "evidenceKind": {
      "enum": [
        "stage5-executable-originated-receipt",
        "stage5-host-runner-receipt",
        "stage5-reviewed-fixture-receipt",
        "stage5-premium-review-receipt",
        "stage5-manual-approval-receipt"
      ]
    },
    "status": { "const": "passed" },
    "role": {
      "enum": [
        "validation-plan", "validation-results", "replay-results",
        "replay-fixture-manifest", "ai-results", "performance-report",
        "combined-results", "premium-review-results", "manual-checklist"
      ]
    },
    "trustDomain": {
      "enum": [
        "executable", "host-runner", "reviewed-fixture", "premium-review",
        "manual-approval"
      ]
    },
    "producer": {
      "enum": [
        "installed-runtime-validation-plan-v2",
        "installed-runtime-validation-results-v2",
        "installed-runtime-replay-results-v2",
        "installed-runtime-ai-results-v2",
        "installed-runtime-performance-report-v2",
        "installed-runtime-combined-results-v2",
        "reviewed-replay-fixture-manifest-v2",
        "stage5-premium-review-receipt-v2",
        "installed-runtime-manual-acceptance-v2",
        "game-executable-stage5-performance-report-v5"
      ]
    },
    "producerVersion": { "enum": ["2", "5"] },
    "runNonce": {
      "type": "string",
      "format": "uuid"
    },
    "sourceCommit": {
      "type": "string",
      "pattern": "^[0-9a-f]{40}$"
    },
    "title": { "enum": ["Generals", "ZeroHour", "Both"] },
    "architecture": { "const": "x64" },
    "artifactSetSha256": { "$ref": "#/$defs/sha256" },
    "executableSha256": {
      "oneOf": [
        { "$ref": "#/$defs/sha256" },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["Generals", "ZeroHour"],
          "properties": {
            "Generals": { "$ref": "#/$defs/sha256" },
            "ZeroHour": { "$ref": "#/$defs/sha256" }
          }
        }
      ]
    },
    "recordedUtc": { "type": "string", "format": "date-time" },
    "cohortNonce": { "type": "string", "format": "uuid" },
    "runtimeClosure": { "$ref": "#/$defs/runtimeClosureBinding" },
    "rawLogs": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "#/$defs/rawLog" }
    },
    "details": { "type": "object" },
    "provenance": { "type": "object" },
    "protection": { "$ref": "#/$defs/protection" }
  },
  "oneOf": [
    { "$ref": "#/$defs/hostRunnerReceipt" },
    { "$ref": "#/$defs/executableReceipt" },
    { "$ref": "#/$defs/reviewedFixtureReceipt" },
    { "$ref": "#/$defs/premiumReviewReceipt" },
    { "$ref": "#/$defs/manualApprovalReceipt" }
  ],
  "allOf": [
    {
      "if": { "properties": { "trustDomain": { "const": "executable" } } },
      "then": { "properties": { "producerVersion": { "const": "5" } } },
      "else": { "properties": { "producerVersion": { "const": "2" } } }
    }
  ],
  "$defs": {
    "sha256": {
      "type": "string",
      "pattern": "^[0-9A-Fa-f]{64}$"
    },
    "relativePath": {
      "type": "string",
      "minLength": 1,
      "not": { "pattern": "^(?:[A-Za-z]:|[\\\\/])" },
      "pattern": "^(?!.*(?:^|[\\\\/])\\.\\.(?:[\\\\/]|$)).+$"
    },
    "rawLog": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name", "path", "sha256"],
      "properties": {
        "name": { "type": "string", "minLength": 1 },
        "path": { "$ref": "#/$defs/relativePath" },
        "sha256": { "$ref": "#/$defs/sha256" }
      }
    },
    "runtimeClosureBinding": {
      "type": "object",
      "additionalProperties": false,
      "required": ["dependencyManifestSha256", "closureSha256"],
      "properties": {
        "dependencyManifestSha256": { "$ref": "#/$defs/sha256" },
        "closureSha256": { "$ref": "#/$defs/sha256" }
      }
    },
    "childStream": {
      "type": "object",
      "additionalProperties": false,
      "required": ["path", "sha256"],
      "properties": {
        "path": { "$ref": "#/$defs/relativePath" },
        "sha256": { "$ref": "#/$defs/sha256" }
      }
    },
    "nativeReceiptReference": {
      "type": "object",
      "additionalProperties": false,
      "required": ["path", "sha256", "producer", "runNonce", "cohortNonce"],
      "properties": {
        "path": { "$ref": "#/$defs/relativePath" },
        "sha256": { "$ref": "#/$defs/sha256" },
        "producer": {
          "type": "string",
          "const": "game-executable-stage5-performance-report-v5"
        },
        "runNonce": { "type": "string", "format": "uuid" },
        "cohortNonce": { "type": "string", "format": "uuid" }
      }
    },
    "hostChild": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "role", "title", "runNonce", "processId", "processCreationUtc",
        "executablePath", "executableSha256", "commandLine", "exitCode",
        "stdout", "stderr", "nativeReceipt"
      ],
      "properties": {
        "role": { "type": "string", "minLength": 1 },
        "title": { "enum": ["Generals", "ZeroHour"] },
        "runNonce": { "type": "string", "format": "uuid" },
        "processId": { "type": "integer", "minimum": 1 },
        "processCreationUtc": { "type": "string", "format": "date-time" },
        "executablePath": { "type": "string", "minLength": 1 },
        "executableSha256": { "$ref": "#/$defs/sha256" },
        "commandLine": { "type": "string", "minLength": 1 },
        "exitCode": { "const": 0 },
        "stdout": { "$ref": "#/$defs/childStream" },
        "stderr": { "$ref": "#/$defs/childStream" },
        "nativeReceipt": { "$ref": "#/$defs/nativeReceiptReference" }
      }
    },
    "hostProvenance": {
      "type": "object",
      "additionalProperties": false,
      "required": ["kind", "runner", "runnerVersion", "childProvenance", "children"],
      "properties": {
        "kind": { "const": "host-runner-observation" },
        "runner": { "type": "string", "minLength": 1 },
        "runnerVersion": { "const": "1" },
        "childProvenance": { "enum": ["bound", "not-applicable"] },
        "children": {
          "type": "array",
          "items": { "$ref": "#/$defs/hostChild" }
        }
      }
    },
    "nativeProvenance": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "kind", "receiptPath", "receiptSha256", "processId",
        "processCreationUtc", "executablePath", "executableSha256",
        "commandLine", "exitCode"
      ],
      "properties": {
        "kind": { "const": "native-executable-observation" },
        "receiptPath": { "$ref": "#/$defs/relativePath" },
        "receiptSha256": { "$ref": "#/$defs/sha256" },
        "processId": { "type": "integer", "minimum": 1 },
        "processCreationUtc": { "type": "string", "format": "date-time" },
        "executablePath": { "type": "string", "minLength": 1 },
        "executableSha256": { "$ref": "#/$defs/sha256" },
        "commandLine": { "type": "string", "minLength": 1 },
        "exitCode": { "const": 0 }
      }
    },
    "reviewedFixtureProvenance": {
      "type": "object",
      "additionalProperties": false,
      "required": ["kind", "reviewedBy", "reviewedUtc", "fixtureManifest"],
      "properties": {
        "kind": { "const": "reviewed-fixture" },
        "reviewedBy": { "type": "string", "minLength": 1 },
        "reviewedUtc": { "type": "string", "format": "date-time" },
        "fixtureManifest": {
          "type": "object",
          "additionalProperties": false,
          "required": ["path", "sha256"],
          "properties": {
            "path": { "$ref": "#/$defs/relativePath" },
            "sha256": { "$ref": "#/$defs/sha256" }
          }
        }
      }
    },
    "externalProvenance": {
      "type": "object",
      "additionalProperties": false,
      "required": ["kind", "reviewedBy", "reviewedUtc"],
      "properties": {
        "kind": { "enum": ["premium-review", "manual-approval"] },
        "reviewedBy": { "type": "string", "minLength": 1 },
        "reviewedUtc": { "type": "string", "format": "date-time" }
      }
    },
    "protection": {
      "type": "object",
      "additionalProperties": false,
      "required": ["kind", "path", "sha256"],
      "properties": {
        "kind": {
          "enum": [
            "external-reviewed-fixture-attestation",
            "external-premium-review-attestation",
            "external-user-manual-approval-attestation"
          ]
        },
        "path": { "$ref": "#/$defs/relativePath" },
        "sha256": { "$ref": "#/$defs/sha256" }
      }
    },
    "combinedSourceReceipt": {
      "type": "object",
      "additionalProperties": false,
      "required": ["title", "path", "sha256", "runNonce", "cohortNonce"],
      "properties": {
        "title": { "enum": ["Generals", "ZeroHour"] },
        "path": { "$ref": "#/$defs/relativePath" },
        "sha256": { "$ref": "#/$defs/sha256" },
        "runNonce": { "type": "string", "format": "uuid" },
        "cohortNonce": { "type": "string", "format": "uuid" }
      }
    },
    "combinedDetails": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "pipelineMode", "simulationMode", "workerPolicy", "renderer",
        "renderThread", "bothTitlesPassed", "sourceReceipts"
      ],
      "properties": {
        "pipelineMode": { "const": "parallel" },
        "simulationMode": { "const": "parallel" },
        "workerPolicy": { "const": "auto" },
        "renderer": { "const": "d3d11" },
        "renderThread": { "const": "dedicated" },
        "bothTitlesPassed": { "const": true },
        "sourceReceipts": {
          "type": "array",
          "minItems": 2,
          "maxItems": 2,
          "items": { "$ref": "#/$defs/combinedSourceReceipt" }
        }
      }
    },
    "commonHostProperties": {
      "type": "object",
      "properties": {
        "trustDomain": { "const": "host-runner" },
        "evidenceKind": { "const": "stage5-host-runner-receipt" },
        "producerVersion": { "const": "2" },
        "provenance": { "$ref": "#/$defs/hostProvenance" }
      }
    },
    "hostRunnerReceipt": {
      "allOf": [
        { "$ref": "#/$defs/commonHostProperties" },
        {
          "type": "object",
          "required": [
            "runNonce", "executableSha256", "rawLogs", "provenance"
          ],
          "oneOf": [
            {
              "required": ["role", "producer"],
              "properties": {
                "role": { "const": "validation-plan" },
                "producer": { "const": "installed-runtime-validation-plan-v2" }
              }
            },
            {
              "required": ["role", "producer"],
              "properties": {
                "role": { "const": "validation-results" },
                "producer": { "const": "installed-runtime-validation-results-v2" }
              }
            },
            {
              "required": ["role", "producer"],
              "properties": {
                "role": { "const": "replay-results" },
                "producer": { "const": "installed-runtime-replay-results-v2" }
              }
            },
            {
              "required": ["role", "producer"],
              "properties": {
                "role": { "const": "ai-results" },
                "producer": { "const": "installed-runtime-ai-results-v2" }
              }
            },
            {
              "required": ["role", "producer"],
              "properties": {
                "role": { "const": "performance-report" },
                "producer": { "const": "installed-runtime-performance-report-v2" }
              }
            },
            {
              "required": ["role", "producer"],
              "properties": {
                "role": { "const": "combined-results" },
                "producer": { "const": "installed-runtime-combined-results-v2" },
                "details": { "$ref": "#/$defs/combinedDetails" }
              }
            }
          ]
        }
      ]
    },
    "executableReceipt": {
      "type": "object",
      "required": [
        "runNonce", "executableSha256", "rawLogs", "provenance"
      ],
      "properties": {
        "trustDomain": { "const": "executable" },
        "evidenceKind": { "const": "stage5-executable-originated-receipt" },
        "role": {
          "enum": [
            "validation-results", "replay-results", "ai-results",
            "performance-report"
          ]
        },
        "producer": {
          "const": "game-executable-stage5-performance-report-v5"
        },
        "provenance": { "$ref": "#/$defs/nativeProvenance" }
      },
      "allOf": [
        {
          "oneOf": [
            {
              "properties": {
                "role": { "const": "validation-results" },
                "producer": { "const": "game-executable-stage5-performance-report-v5" }
              }
            },
            {
              "properties": {
                "role": { "const": "replay-results" },
                "producer": { "const": "game-executable-stage5-performance-report-v5" }
              }
            },
            {
              "properties": {
                "role": { "const": "ai-results" },
                "producer": { "const": "game-executable-stage5-performance-report-v5" }
              }
            },
            {
              "properties": {
                "role": { "const": "performance-report" },
                "producer": { "const": "game-executable-stage5-performance-report-v5" }
              }
            }
          ]
        }
      ]
    },
    "reviewedFixtureReceipt": {
      "type": "object",
      "required": ["provenance", "protection"],
      "properties": {
        "trustDomain": { "const": "reviewed-fixture" },
        "evidenceKind": { "const": "stage5-reviewed-fixture-receipt" },
        "role": { "const": "replay-fixture-manifest" },
        "producer": { "const": "reviewed-replay-fixture-manifest-v2" },
        "provenance": { "$ref": "#/$defs/reviewedFixtureProvenance" },
        "protection": {
          "allOf": [
            { "$ref": "#/$defs/protection" },
            { "properties": { "kind": { "const": "external-reviewed-fixture-attestation" } } }
          ]
        }
      }
    },
    "premiumReviewReceipt": {
      "type": "object",
      "required": ["provenance", "protection"],
      "properties": {
        "trustDomain": { "const": "premium-review" },
        "evidenceKind": { "const": "stage5-premium-review-receipt" },
        "role": { "const": "premium-review-results" },
        "producer": { "const": "stage5-premium-review-receipt-v2" },
        "provenance": { "$ref": "#/$defs/externalProvenance" },
        "protection": {
          "allOf": [
            { "$ref": "#/$defs/protection" },
            { "properties": { "kind": { "const": "external-premium-review-attestation" } } }
          ]
        }
      }
    },
    "manualApprovalReceipt": {
      "type": "object",
      "required": ["provenance", "protection"],
      "properties": {
        "trustDomain": { "const": "manual-approval" },
        "evidenceKind": { "const": "stage5-manual-approval-receipt" },
        "role": { "const": "manual-checklist" },
        "producer": { "const": "installed-runtime-manual-acceptance-v2" },
        "provenance": { "$ref": "#/$defs/externalProvenance" },
        "protection": {
          "allOf": [
            { "$ref": "#/$defs/protection" },
            { "properties": { "kind": { "const": "external-user-manual-approval-attestation" } } }
          ]
        }
      }
    }
  }
}
