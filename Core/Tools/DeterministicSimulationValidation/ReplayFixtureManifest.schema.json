{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://generalsgamecode.invalid/schemas/stage5-replay-fixtures.json",
  "title": "GeneralsGameCode Stage 5 replay and AI validation manifest",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "title", "executable", "executableSha256", "fixtures", "ai"],
  "properties": {
    "schemaVersion": { "type": "integer", "enum": [1, 2] },
    "title": { "type": "string", "enum": ["Generals", "ZeroHour"] },
    "executable": { "type": "string", "pattern": "^[A-Za-z0-9._-]+\\.exe$" },
    "executableSha256": { "$ref": "#/$defs/sha256" },
    "fixtures": { "type": "array", "minItems": 1, "items": { "$ref": "#/$defs/fixture" } },
    "ai": {}
  },
  "oneOf": [
    { "properties": { "schemaVersion": { "type": "integer", "const": 1 }, "ai": { "$ref": "#/$defs/aiV1" } } },
    { "properties": { "schemaVersion": { "type": "integer", "const": 2 }, "ai": { "$ref": "#/$defs/aiV2" } } }
  ],
  "allOf": [
    {
      "if": { "properties": { "title": { "type": "string", "const": "Generals" } }, "required": ["title"] },
      "then": { "properties": { "executable": { "pattern": "^generalsv(?:-[A-Za-z0-9._-]+)?\\.exe$" } } }
    },
    {
      "if": { "properties": { "title": { "type": "string", "const": "ZeroHour" } }, "required": ["title"] },
      "then": { "properties": { "executable": { "pattern": "^generalszh(?:-[A-Za-z0-9._-]+)?\\.exe$" } } }
    }
  ],
  "$defs": {
    "sha256": { "type": "string", "pattern": "^[0-9A-Fa-f]{64}$" },
    "reviewedAiMap": {
      "type": "object", "additionalProperties": false,
      "required": ["source", "mapKey", "sha256", "byteCount", "crc"],
      "properties": {
        "source": { "type": "string", "minLength": 1, "pattern": "^(?!.*[:\\u0000-\\u001f]).+\\.map$" },
        "mapKey": { "type": "string", "pattern": "^Maps\\\\[A-Za-z0-9_-][A-Za-z0-9_. -]{0,63}\\\\[A-Za-z0-9_-][A-Za-z0-9_. -]{0,127}\\.map$" },
        "sha256": { "type": "string", "pattern": "^[0-9A-F]{64}$" },
        "byteCount": { "type": "integer", "minimum": 16384, "maximum": 67108864 },
        "crc": { "type": "string", "pattern": "^[0-9A-F]{8}$" }
      }
    },
    "fixture": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "source", "sha256", "stress"],
      "properties": {
        "id": { "type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{0,63}$" },
        "source": { "type": "string", "minLength": 1 },
        "sha256": { "$ref": "#/$defs/sha256" },
        "stress": { "type": "boolean" },
        "maps": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["source", "profileRelativePath", "sha256"],
            "properties": {
              "source": { "type": "string", "minLength": 1 },
              "profileRelativePath": { "type": "string", "pattern": "^Maps[\\\\/]" },
              "sha256": { "$ref": "#/$defs/sha256" }
            }
          }
        }
      }
    },
    "seeds": {
      "type": "array", "minItems": 1, "maxItems": 32, "uniqueItems": true,
      "items": { "type": "integer", "minimum": 1, "maximum": 2147483647 }
    },
    "scenarios": {
      "type": "array", "minItems": 1, "uniqueItems": true,
      "items": { "type": "string", "enum": ["4v3", "4v2", "hard-ai-2v6"] }
    },
    "repeats": { "type": "integer", "minimum": 1, "maximum": 10 },
    "authoritySelector": {
      "type": "object",
      "additionalProperties": false,
      "required": ["scenario", "seed", "configuration", "repeat"],
      "properties": {
        "scenario": { "type": "string", "const": "4v2" },
        "seed": { "type": "integer", "minimum": 1, "maximum": 2147483647 },
        "configuration": { "type": "string", "enum": ["parallel-2", "parallel-4", "parallel-8", "parallel-16", "parallel-auto"] },
        "repeat": { "$ref": "#/$defs/repeats" }
      }
    },
    "shadowSelector": {
      "type": "object",
      "additionalProperties": false,
      "required": ["scenario", "seed", "configuration", "repeat"],
      "properties": {
        "scenario": { "type": "string", "const": "4v2" },
        "seed": { "type": "integer", "minimum": 1, "maximum": 2147483647 },
        "configuration": { "type": "string", "enum": ["shadow-8", "shadow-16"] },
        "repeat": { "$ref": "#/$defs/repeats" }
      }
    },
    "liveQualification": {
      "type": "object",
      "additionalProperties": false,
      "required": ["schemaVersion", "profileSetId", "authorityEntries", "shadowEntry"],
      "properties": {
        "schemaVersion": { "type": "integer", "const": 1 },
        "profileSetId": { "type": "string", "const": "live-all-slices-v1" },
        "authorityEntries": {
          "type": "array", "minItems": 1, "uniqueItems": true,
          "items": { "$ref": "#/$defs/authoritySelector" }
        },
        "shadowEntry": { "$ref": "#/$defs/shadowSelector" }
      }
    },
    "aiV1": {
      "type": "object",
      "additionalProperties": false,
      "required": ["seeds", "scenarios", "repeats"],
      "properties": {
        "seeds": { "$ref": "#/$defs/seeds" },
        "scenarios": { "$ref": "#/$defs/scenarios" },
        "repeats": { "$ref": "#/$defs/repeats" },
        "reviewedMap": { "$ref": "#/$defs/reviewedAiMap" }
      }
    },
    "aiV2": {
      "type": "object",
      "additionalProperties": false,
      "required": ["seeds", "scenarios", "repeats", "liveQualification"],
      "properties": {
        "seeds": { "$ref": "#/$defs/seeds" },
        "scenarios": { "$ref": "#/$defs/scenarios" },
        "repeats": { "$ref": "#/$defs/repeats" },
        "liveQualification": { "$ref": "#/$defs/liveQualification" },
        "reviewedMap": { "$ref": "#/$defs/reviewedAiMap" }
      }
    }
  }
}
