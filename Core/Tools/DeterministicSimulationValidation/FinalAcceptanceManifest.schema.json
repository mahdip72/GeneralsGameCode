{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://generalsgamecode.invalid/schemas/stage5-final-acceptance.json",
  "title": "GeneralsGameCode Stage 5 final acceptance request",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "gateName", "sourceCommit", "cohortNonce",
    "cohortCreatedUtc", "artifactSet", "evidence"],
  "properties": {
    "schemaVersion": { "const": 1 },
    "gateName": { "const": "final-stage5-acceptance" },
    "sourceCommit": { "type": "string", "pattern": "^[0-9A-Fa-f]{40}$" },
    "cohortNonce": { "type": "string", "format": "uuid" },
    "cohortCreatedUtc": { "type": "string", "format": "date-time" },
    "artifactSet": { "$ref": "#/$defs/fileReference" },
    "evidence": {
      "type": "array",
      "minItems": 6,
      "maxItems": 6,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["kind", "path", "sha256"],
        "properties": {
          "kind": {
            "enum": [
              "deterministic-runtime",
              "replay-determinism",
              "fresh-ai",
              "performance-scaling",
              "mixed-worker-multiplayer",
              "combined-stage4-stage5-installed-runtime"
            ]
          },
          "path": { "$ref": "#/$defs/relativePath" },
          "sha256": { "$ref": "#/$defs/sha256" }
        }
      }
    }
  },
  "$defs": {
    "relativePath": {
      "type": "string",
      "minLength": 1,
      "not": { "pattern": "^(?:[A-Za-z]:|[\\/])" },
      "pattern": "^(?!.*(?:^|[\\/])\\.\\.(?:[\\/]|$)).+$"
    },
    "sha256": { "type": "string", "pattern": "^[0-9A-Fa-f]{64}$" },
    "fileReference": {
      "type": "object",
      "additionalProperties": false,
      "required": ["path", "sha256"],
      "properties": {
        "path": { "$ref": "#/$defs/relativePath" },
        "sha256": { "$ref": "#/$defs/sha256" }
      }
    }
  }
}
