{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "PerformanceScalingRawSamples.schema.json",
  "title": "Installed Stage 5 performance raw-sample manifest",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "evidenceKind", "producer", "sourceCommit", "artifactSetSha256", "title", "executableSha256", "stage3SourceCommit", "stage3ExecutableSha256", "stage3BaselineSha256", "measurementMode", "installedRuntime", "topologyReceipt", "fixtureSamples", "phaseSamples", "kernelSamples"],
  "properties": {
    "schemaVersion": { "const": 2 },
    "evidenceKind": { "const": "stage5-performance-scaling-raw-samples" },
    "producer": { "const": "installed-runtime-scaling-runner-v2" },
    "sourceCommit": { "type": "string", "pattern": "^[0-9a-f]{40}$" },
    "artifactSetSha256": { "$ref": "#/$defs/sha256" },
    "title": { "enum": ["Generals", "ZeroHour"] },
    "executableSha256": { "$ref": "#/$defs/sha256" },
    "stage3SourceCommit": { "type": "string", "pattern": "^[0-9a-f]{40}$" },
    "stage3ExecutableSha256": { "$ref": "#/$defs/sha256" },
    "stage3BaselineSha256": { "$ref": "#/$defs/sha256" },
    "measurementMode": { "const": "headless-throughput" },
    "installedRuntime": { "const": true },
    "topologyReceipt": { "$ref": "#/$defs/evidenceFile" },
    "fixtureSamples": { "type": "array", "minItems": 48, "items": { "$ref": "#/$defs/fixtureSample" } },
    "phaseSamples": { "type": "array", "minItems": 15, "items": { "$ref": "#/$defs/phaseSample" } },
    "kernelSamples": { "type": "array", "minItems": 18, "items": { "$ref": "#/$defs/kernelSample" } }
  },
  "$defs": {
    "sha256": { "type": "string", "pattern": "^[0-9A-F]{64}$" },
    "evidenceFile": {
      "type": "object", "additionalProperties": false,
      "required": ["path", "sha256"],
      "properties": {
        "path": { "type": "string", "minLength": 1 },
        "sha256": { "$ref": "#/$defs/sha256" }
      }
    },
    "fixtureSample": {
      "type": "object", "additionalProperties": false,
      "required": ["fixture", "playerCount", "peakUnitCount", "requestedMinimumUnitCount", "initialUnitCount", "lane", "repeat", "processId", "executableSha256", "commandLine", "elapsedMilliseconds"],
      "properties": {
        "fixture": { "enum": ["one-thousand-units", "four-thousand-units", "eight-thousand-units", "dense-eight-player"] },
        "playerCount": { "const": 8 },
        "peakUnitCount": { "type": "integer", "minimum": 1000 },
        "requestedMinimumUnitCount": { "type": "integer", "minimum": 1000 },
        "initialUnitCount": { "type": "integer", "minimum": 1000 },
        "lane": { "enum": ["stage3-forced-one", "forced-one", "physical-8", "physical-16"] },
        "repeat": { "type": "integer", "minimum": 0 },
        "processId": { "type": "integer", "minimum": 1 },
        "executableSha256": { "$ref": "#/$defs/sha256" },
        "commandLine": { "type": "string", "minLength": 1 },
        "elapsedMilliseconds": { "type": "number", "exclusiveMinimum": 0 }
      }
    },
    "phaseSample": {
      "type": "object", "additionalProperties": false,
      "required": ["phase", "repeat", "processId", "commandLine", "elapsedMilliseconds", "serialMilliseconds", "serialMillisecondsKnown"],
      "properties": {
        "phase": { "enum": ["owner-intake", "legacy-mutable-island", "spatial-work", "owner-tail", "verification-publication"] },
        "repeat": { "type": "integer", "minimum": 0 },
        "processId": { "type": "integer", "minimum": 1 },
        "commandLine": { "type": "string", "minLength": 1 },
        "elapsedMilliseconds": { "type": "number", "exclusiveMinimum": 0 },
        "serialMilliseconds": { "type": "number", "minimum": 0 },
        "serialMillisecondsKnown": { "const": true }
      }
    },
    "kernelSample": {
      "type": "object", "additionalProperties": false,
      "required": ["kernel", "repeat", "processId", "commandLine", "admittedSlices", "captureMilliseconds", "scheduleMilliseconds", "waitMilliseconds", "validateMilliseconds", "commitMilliseconds", "exactSerialOperationMilliseconds", "exactSerialOperationMillisecondsKnown", "timingAttribution"],
      "properties": {
        "kernel": { "enum": ["physics", "status", "collision", "ai-planning", "spatial", "path"] },
        "repeat": { "type": "integer", "minimum": 0 },
        "processId": { "type": "integer", "minimum": 1 },
        "commandLine": { "type": "string", "minLength": 1 },
        "admittedSlices": { "type": "integer", "minimum": 1 },
        "captureMilliseconds": { "type": "number", "minimum": 0 },
        "scheduleMilliseconds": { "type": "number", "minimum": 0 },
        "waitMilliseconds": { "type": "number", "minimum": 0 },
        "validateMilliseconds": { "type": "number", "minimum": 0 },
        "commitMilliseconds": { "type": "number", "minimum": 0 },
        "exactSerialOperationMilliseconds": { "type": "number", "exclusiveMinimum": 0 },
        "exactSerialOperationMillisecondsKnown": { "const": true },
        "timingAttribution": { "const": "owner-stack-exclusive-v1" }
      }
    }
  }
}
